<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>10.0.0</Version>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Boar.Red.Service</Title>
    <AssemblyVersion>10.0.0</AssemblyVersion>
    <FileVersion>10.0.0</FileVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Boar_Red_600x600@1x.png</PackageIcon>
    <ApplicationIcon>Boar_Red_600x600@1x.ico</ApplicationIcon>
    <Copyright>Boar.Red</Copyright>
    <PackageProjectUrl>https://github.com/Boar-Red/Boar.Red.Service</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Boar-Red/Boar.Red.Service</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>微服务;</PackageTags>
    <PackageReleaseNotes>Boar.Red 服务基本功能。</PackageReleaseNotes>
    <Description>Boar.Red 微服务（微服务架构）基础程序库。</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Boar.Red</Authors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="BrService\Utils\**" />
    <EmbeddedResource Remove="BrService\Utils\**" />
    <None Remove="BrService\Utils\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Boar_Red_600x600@1x.ico" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="BaoXia.Constants" Version="10.0.0" />
    <PackageReference Include="BaoXia.Utils" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="Boar_Red_600x600@1x.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
